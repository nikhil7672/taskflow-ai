# PostgreSQL connection used by Prisma. Replace with your local database URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taskflow_ai?schema=public"

# Express API
API_PORT=4000
API_HOST=localhost
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false
SESSION_COOKIE_DOMAIN=

# Next.js frontend. Browser and server requests use these API origins.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
API_INTERNAL_BASE_URL=http://localhost:4000/api/v1

# Password reset email delivery webhook (optional in development, required in production).
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
EMAIL_FROM=
