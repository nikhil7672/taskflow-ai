
{
  "name": "@taskflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:push": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js db push --schema prisma/schema.prisma",
    "db:migrate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "db:migrate:status": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate status --schema prisma/schema.prisma",
    "db:studio": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js studio --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
