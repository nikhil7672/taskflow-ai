generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ProjectMemberRole {
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_COMMENT
  PROJECT_UPDATE
  WORKSPACE_INVITATION
  MENTION
  SYSTEM
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique @db.VarChar(320)
  name            String?   @db.VarChar(160)
  imageUrl        String?   @db.Text
  passwordHash    String?   @db.Text
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  workspacesCreated   Workspace[]          @relation("WorkspaceCreator")
  memberships         WorkspaceMember[]
  projectsCreated     Project[]            @relation("ProjectCreator")
  projectMemberships  ProjectMember[]
  tasksCreated        Task[]               @relation("TaskCreator")
  assignedTasks       Task[]               @relation("TaskAssignee")
  comments            TaskComment[]
  attachments         TaskAttachment[]
  notifications       Notification[]       @relation("NotificationRecipient")
  notificationsSent   Notification[]       @relation("NotificationActor")
  activities          ActivityLog[]        @relation("ActivityActor")
  invitationsSent     Invitation[]         @relation("InvitationSender")
  invitationsAccepted Invitation[]         @relation("InvitationAccepter")

  @@index([createdAt])
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  type                 String    @db.VarChar(32)
  provider             String    @db.VarChar(64)
  providerAccountId    String    @db.VarChar(255)
  refreshToken         String?   @db.Text
  accessToken          String?   @db.Text
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  tokenType            String?   @db.VarChar(64)
  scope                String?   @db.Text
  idToken              String?   @db.Text
  sessionState         String?   @db.Text
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(100)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  createdBy     User?             @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members       WorkspaceMember[]
  projects      Project[]
  invitations   Invitation[]
  notifications Notification[]
  activities    ActivityLog[]
  outboxEvents  OutboxEvent[]

  @@index([createdById])
  @@index([updatedAt])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now()) @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, role])
  @@index([workspaceId, role])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  createdById String?
  name        String        @db.VarChar(160)
  slug        String        @db.VarChar(160)
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  color       String?       @db.VarChar(32)
  startDate   DateTime?     @db.Date
  dueDate     DateTime?     @db.Date
  archivedAt  DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  tasks         Task[]
  notifications Notification[]
  activities    ActivityLog[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, updatedAt])
  @@index([createdById])
  @@index([dueDate])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  addedAt   DateTime          @default(now()) @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, role])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  createdById String?
  assigneeId  String?
  parentId    String?
  title       String       @db.VarChar(240)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  position    Decimal      @default(0) @db.Decimal(12, 4)
  startAt     DateTime?    @db.Timestamptz(3)
  dueAt       DateTime?    @db.Timestamptz(3)
  completedAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent        Task?            @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks      Task[]           @relation("TaskSubtasks")
  comments      TaskComment[]
  attachments   TaskAttachment[]
  dependencies  TaskDependency[] @relation("TaskDependsOn")
  dependents    TaskDependency[] @relation("TaskRequiredBy")
  notifications Notification[]
  activities    ActivityLog[]

  @@index([projectId, status, position])
  @@index([projectId, dueAt])
  @@index([assigneeId, status, dueAt])
  @@index([createdById])
  @@index([parentId, position])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  content   String    @db.Text
  editedAt  DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String?
  storageKey   String   @unique @db.VarChar(512)
  fileName     String   @db.VarChar(255)
  mimeType     String   @db.VarChar(127)
  sizeBytes    BigInt
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([uploadedById])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  task      Task @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskRequiredBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId, taskId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  actorId     String?
  workspaceId String?
  projectId   String?
  taskId      String?
  type        NotificationType
  title       String           @db.VarChar(200)
  body        String?          @db.Text
  payload     Json?
  readAt      DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  user      User       @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  projectId   String?
  taskId      String?
  action      String   @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  workspaceId   String
  eventType     String    @db.VarChar(100)
  aggregateType String    @db.VarChar(64)
  aggregateId   String    @db.VarChar(191)
  payload       Json
  attempts      Int       @default(0)
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model Invitation {
  id           String              @id @default(cuid())
  workspaceId  String
  invitedById  String?
  acceptedById String?
  email        String              @db.VarChar(320)
  role         WorkspaceMemberRole @default(MEMBER)
  status       InvitationStatus    @default(PENDING)
  tokenHash    String              @unique @db.VarChar(255)
  expiresAt    DateTime            @db.Timestamptz(3)
  acceptedAt   DateTime?           @db.Timestamptz(3)
  revokedAt    DateTime?           @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?     @relation("InvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email, status])
  @@index([email, status, expiresAt])
  @@index([invitedById])
}
